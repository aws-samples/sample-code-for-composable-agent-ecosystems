# Tessera — local deploy environment template.
# Copy to .env and adjust. Consumed by the Makefile / scripts for local deploys.
# NEVER commit a real .env. Secrets (e.g. web-search API key) live in AgentCore
# Identity Token Vault, never here.

# AWS targeting (your SSO profile + region). The account id is resolved automatically.
AWS_PROFILE=your-sso-profile
AWS_REGION=<your aws region>

# Which environment's tfvars/backend to use: dev | staging | prod
ENVIRONMENT=dev

# Terraform state bucket (also set in environments/<env>/backend.hcl).
# S3 bucket names are GLOBALLY unique, so include the AWS account id + region.
# Replace <ACCOUNT_ID> with your 12-digit account id and <REGION> with your region.
# This matches the default `make bootstrap` suggests, e.g.:
#   tessera-tfstate-123456789012-us-east-1
TF_STATE_BUCKET=tessera-tfstate-<ACCOUNT_ID>-<REGION>

# Web search (Tavily): the API key is NOT stored here. Set it once per account into
# Secrets Manager with:  make set-websearch-key ENV=dev
# Terraform then provisions the AgentCore credential provider from that secret, and
# `make verify-websearch ENV=dev` (also a CI stage) fails loudly if it's missing.
